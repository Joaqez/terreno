// Copiar y pegar en la consola de Firebase: Storage → Reglas.
//
// Mismo criterio que firestore.rules: exige sesión iniciada (Firebase Auth)
// para leer o escribir cualquier archivo. Todavía no distingue "dueño del
// archivo" — ver la misma nota en firestore.rules.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
