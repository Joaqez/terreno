# Copia este archivo a ".env" y completa los valores reales del proyecto de
# Firebase de la empresa (Firebase console → Configuración del proyecto →
# tus apps → SDK setup and configuration). El archivo ".env" NUNCA se sube
# al repo (está en .gitignore).
#
# El prefijo EXPO_PUBLIC_ es obligatorio: es lo que hace que Expo incluya
# estas variables en el bundle de la app. No pongas acá ningún secreto que
# no deba viajar dentro de la app (las API keys de Firebase están pensadas
# para ir en el cliente; el control de acceso real se hace con las reglas
# de seguridad de Firestore/Storage, no ocultando esta key).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
